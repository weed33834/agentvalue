# =============================================================================
# AgentValue — Environment Configuration Reference
# =============================================================================
# Copy this file to `.env` and customize each variable for your environment.
#
# Naming Convention:
#   1. All variables use SCREAMING_SNAKE_CASE
#   2. Corresponding Settings fields use lower_snake_case
#   3. Booleans: true / false (case-insensitive)
#   4. Lists: comma-separated (e.g., CORS_ORIGINS=http://a,http://b)
#   5. Legacy compat fields (OPENAI_* fallback to CLOUD_*) kept for migration
#   6. New fields prefix with AGENTVALUE_ or domain prefix (OCR_/ASR_/S3_)
# =============================================================================

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                        APPLICATION BASICS                                ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Application display name (used in responses, email templates, etc.)
APP_NAME=AgentValue

# Debug mode: enables verbose logging, more detailed error responses
# Set to false in production to avoid leaking internal state
DEBUG=false

# Environment identifier: 'development' or 'production'
# When set to 'production', enables additional safety guards:
#   - Demo auth mode is forcibly disabled
#   - CORS validation is strict
#   - Guardrails are enforced
# AGENTVALUE_ENV=production

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                          DATABASE                                        ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Database connection string.
# Default: SQLite (good for development and single-server deployments).
# Production: Use PostgreSQL for multi-worker, high-availability scenarios.
#
# Examples:
#   SQLite:    sqlite+aiosqlite:///./agentvalue.db
#   PostgreSQL: postgresql+asyncpg://user:password@host:5432/agentvalue
DATABASE_URL=sqlite+aiosqlite:///./agentvalue.db

# PostgreSQL connection pool settings (only effective with PostgreSQL)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=3600
# DB_POOL_PRE_PING=true

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                    TASK QUEUE & CACHE (Redis)                            ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Redis connection string for task queue and caching.
# Leave empty to use in-memory queue (single-instance only).
# Required for multi-worker deployments and the arq background queue.
# REDIS_URL=redis://redis:6379/0

# arq task queue (optional): use dedicated worker + auto-retry + dead-letter queue
# USE_ARQ_QUEUE=false
# ARQ_MAX_TRIES=3
# ARQ_JOB_TIMEOUT=600

# PostgreSQL checkpointer (optional): persist interrupt/approval state to PG
# Enables multi-worker support for the evaluation state machine
# USE_POSTGRES_CHECKPOINTER=false

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                       LLM MODEL TIER                                     ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Model tier selector — controls which LLM is used for evaluation & chat.
#   auto    = Auto-detect from hardware (recommended default)
#   L0      = Cloud flagship (GPT-4o, DeepSeek-V3, Qwen-Max)
#   L1      = Edge/small local model (Qwen2.5-0.5B)
#   L2      = Standard local model (Qwen2.5-7B)
#   L3      = Flagship local model (Qwen2.5-14B)
MODEL_TIER=auto

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                   CLOUD LLM PROVIDER (Primary)                           ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Cloud LLM endpoint — supports any OpenAI-compatible API:
#   - DeepSeek:     https://api.deepseek.com/v1
#   - Alibaba Bailian: https://dashscope.aliyuncs.com/compatible-mode/v1
#   - SiliconFlow: https://api.siliconflow.cn/v1
#   - OpenAI:       https://api.openai.com/v1
CLOUD_API_KEY=your-cloud-api-key
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_MODEL=gpt-4o-mini

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║             CLOUD LLM PROVIDER (Legacy OpenAI Fallback)                   ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Legacy OpenAI fields — used as fallback when CLOUD_* variables are not set.
# Kept for backward compatibility during migration.
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                  LOCAL LLM (LM Studio / Ollama)                          ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Local model endpoint — for on-premises deployment where data must not leave
# the network. Supports LM Studio, Ollama, Xinference, or any OpenAI-compatible
# local inference server.
LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_API_KEY=lm-studio

# Local models by tier — choose models appropriate for your hardware:
LOCAL_MODEL_L1=qwen2.5-0.5b-instruct
LOCAL_MODEL_L2=qwen2.5-7b-instruct
LOCAL_MODEL_L3=qwen2.5-14b-instruct

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                ADDITIONAL PROVIDERS (Optional Fallbacks)                 ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# For the Prompt Playground: these serve as fallback credentials when
# tenant-level provider credentials (configured via /admin/providers) are not set.
# In production, configure provider credentials via the admin UI (AES-256-GCM encrypted).
# These env vars are only for quick local playground testing.
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# GEMINI_API_KEY=your-gemini-key
# OLLAMA_BASE_URL=http://localhost:11434

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                  EMBEDDING & VECTOR STORE                                ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Embedding service (OpenAI-compatible API).
# Use cloud service (OpenAI / DeepSeek / Qianfan) or local (Ollama / Xinference).
#
# When EMBEDDING_API_KEY is not set, the system falls back to DummyEmbeddingFunction
# (md5-based pseudo-vectors — interface testing only, no real semantic search).
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Embedding dimensions — MUST match your model:
#   OpenAI text-embedding-3-small = 1536
#   BGE large zh v1.5 (local)   = 1024
#   Dummy embedding (no API key) = 384
#
# IMPORTANT: When switching from Dummy to a real embedding model, you MUST
# rebuild the vector store: python -m scripts.seed_kb --clear
EMBEDDING_DIMENSIONS=1536

# Vector database storage path
VECTOR_STORE_DIR=./chroma_db

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                  FILE ATTACHMENTS & STORAGE                              ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Attachment storage directory — files uploaded by users are stored here.
# Acts as the path traversal protection whitelist root.
ATTACHMENT_DIR=./attachments

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                     LLM INFERENCE PARAMETERS                             ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# LLM inference temperature (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.1

# Maximum tokens per LLM response
MAX_TOKENS=4096

# LLM request timeout in seconds
LLM_REQUEST_TIMEOUT=120

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                      AUTHENTICATION (JWT)                                ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# JWT signing secret — MUST change for production.
# Generate a strong random key:
#   openssl rand -base64 32
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-strong-random-secret

# JWT signing algorithm. HS256 is default; RS256 supported for SSO scenarios.
JWT_ALGORITHM=HS256

# Token expiration in minutes (default: 1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440

# JWT claims validation (recommended for production to prevent token reuse
# across different services in your infrastructure):
# JWT_AUDIENCE=agentvalue-api
# JWT_ISSUER=agentvalue-auth
# JWT_LEEWAY_SECONDS=30   # Clock skew tolerance

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                       CORS CONFIGURATION                                 ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Comma-separated list of allowed origins for CORS.
# Production: set to your actual frontend domain(s). NEVER use '*' with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                   VISION / MULTIMODAL (OCR)                              ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Vision model for OCR/extracting text from images (OpenAI vision API compatible)
VISION_MODEL=gpt-4o-mini

# Multimodal configuration (Phase 7.1)
OCR_PROVIDER=none          # OCR engine provider
OCR_LANG=chi_sim+eng       # OCR language(s)
OCR_CLOUD_PROVIDER=aliyun  # Cloud OCR provider (legacy)
OCR_CLOUD_SECRET_KEY=      # Legacy cloud OCR secret
ASR_PROVIDER=dummy         # Speech-to-text provider
WHISPER_MODEL=base         # Whisper model size
MULTIMODAL_CONFIDENCE_THRESHOLD=0.7  # Minimum confidence for extracted data

# Cloud OCR/ASR (Phase 10) — uses OpenAI-compatible vision & whisper APIs.
# When not configured, falls back to local tesseract (OCR) and DummyASR.
OCR_CLOUD_API_KEY=
OCR_CLOUD_BASE_URL=https://api.openai.com/v1
OCR_CLOUD_MODEL=gpt-4o-mini
ASR_CLOUD_API_KEY=
ASR_CLOUD_BASE_URL=https://api.openai.com/v1
ASR_CLOUD_MODEL=whisper-1

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                 OBJECT STORAGE (S3 / MinIO)                              ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# S3-compatible object storage for attachments (MinIO / AWS S3 / Alibaba OSS).
# Leave empty to use local ATTACHMENT_DIR filesystem storage.
# S3_ENDPOINT=minio:9000
# S3_ACCESS_KEY=your-minio-access-key
# S3_SECRET_KEY=your-minio-secret-key
# S3_BUCKET=agentvalue-attachments
# S3_SECURE=false

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║               DATA RETENTION & COMPLIANCE (GDPR / PIPL)                 ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Raw evaluation input retention (days). After this period, raw inputs are purged.
RETENTION_RAW_INPUT_DAYS=730
# Evaluation result retention (days)
RETENTION_EVALUATION_DAYS=1825
# Extra buffer before final purge (days)
RETENTION_ARCHIVE_BUFFER_DAYS=30

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                   FIELD-LEVEL ENCRYPTION                                 ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# AES-GCM encryption key for sensitive database fields (manager_view, audit_view).
# When empty, sensitive fields are stored as plaintext (development only).
# Production: REQUIRE this to be set.
#
# Generate a key:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=

# Encryption backend (env / vault / aws / aliyun). Default: env = local AES-GCM.
FIELD_ENCRYPTION_BACKEND=env

# DEK cache configuration (used with KMS backends)
KMS_DEK_CACHE_TTL_SECONDS=300
KMS_DEK_CACHE_MAX_SIZE=1000
KMS_DEK_CACHE_MAX_MESSAGES=100
KMS_DEK_CACHE_MAX_BYTES=67108864

# HashiCorp Vault KMS (for FIELD_ENCRYPTION_BACKEND=vault)
# VAULT_ADDR=http://vault:8200
# VAULT_AUTH_METHOD=token
# VAULT_TOKEN=your-vault-token
# VAULT_KV_MOUNT=secret
# VAULT_TRANSIT_MOUNT=transit

# AWS KMS (for FIELD_ENCRYPTION_BACKEND=aws)
# AWS_KMS_KEY_ID=alias/agentvalue-field-key
# AWS_KMS_REGION=us-east-1

# Alibaba Cloud KMS (for FIELD_ENCRYPTION_BACKEND=aliyun)
# ALIYUN_KMS_KEY_ID=your-kms-key-id
# ALIYUN_KMS_ENDPOINT=kms.cn-hangzhou.aliyuncs.com

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                    DEMO MODE & AUTH                                      ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Demo authentication mode.
# When true, allows impersonating any user via x-user-role / x-user-id HTTP headers.
# For LOCAL DEVELOPMENT AND TESTING ONLY. NEVER enable in production.
AUTH_DEMO_MODE=false

# Default password for demo users
DEMO_DEFAULT_PASSWORD=agentvalue123

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                    OBSERVABILITY (Langfuse)                              ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Langfuse credentials for LLM tracing & observability.
# Leave empty to skip Langfuse integration.
LANGFUSE_PUBLIC_KEY=your-public-key
LANGFUSE_SECRET_KEY=your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# Prometheus metrics endpoint access control
#   none  = open to all
#   ip    = restrict to internal network IPs (default)
#   token = bearer token authentication
METRICS_AUTH_MODE=ip
# METRICS_BEARER_TOKEN=your-metrics-token
# METRICS_ALLOWED_IPS=127.0.0.1,10.0.0.0/8

# Prometheus query URL (for Token Trends dashboard; default = localhost)
# PROMETHEUS_URL=http://localhost:9090

# Guardrails false-positive metrics tracking
# When true, records agentvalue_guard_checks_total / agentvalue_guard_false_positives_total
GUARD_RAILS_METRICS_ENABLED=true

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                    CONTENT SAFETY GUARDRAILS                             ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Input guard — detects prompt injection, jailbreak attempts, PII leaks
# INPUTGUARD_ENABLED=true

# Output guard — detects bias, hallucinations, sensitive content
# OUTPUTGUARD_ENABLED=true

# Advanced ML-based injection detection (P1-26):
# Requires: pip install transformers torch
# INJECTION_DETECTION_ENABLED=false
# INJECTION_DETECTION_THRESHOLD=0.8
# INJECTION_MODEL_NAME=deepset/roberta-base-injection

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                    RERANK PROVIDER (Knowledge Base)                      ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Reranker enhances knowledge base retrieval by re-ranking search results.
# Options: cohere / jina / bge (local) / dummy (no-op)
# RERANK_PROVIDER=dummy
# RERANK_API_KEY=your-rerank-api-key
# RERANK_BASE_URL=https://api.cohere.ai/v1
# RERANK_MODEL=rerank-multilingual-v3.0
# RERANK_TOP_K=5

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                  KNOWLEDGE BASE CHUNKING                                 ║
# ╚════════════════════════════════════════════════════════════════════════════╝

CHUNK_SIZE=800           # Character size of each document chunk
CHUNK_OVERLAP=100        # Overlap between adjacent chunks

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                    AGENT TOOL CONFIGURATION                              ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Comma-separated list of enabled agent tools. Comment out to enable all.
# Example (production-safe, minimal tools):
# ENABLED_TOOLS=calculator,get_current_datetime,query_company_kb

# Maximum ReAct loop iterations per agent turn
# REACT_AGENT_MAX_ITERATIONS=10

# MCP server configuration (JSON format for Model Context Protocol servers)
# MCP_SERVERS=[{"name":"custom","url":"http://localhost:3000/mcp"}]

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                   ENTERPRISE INTEGRATIONS (Optional)                     ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Feishu/Lark IM integration (optional; falls back to DummyIMAdapter)
# FEISHU_APP_ID=your-feishu-app-id
# FEISHU_APP_SECRET=your-feishu-app-secret
# FEISHU_WEBHOOK_SECRET=your-webhook-secret

# GitLab code repository integration (optional; falls back to DummyCodeRepoAdapter)
# GITLAB_BASE_URL=https://gitlab.example.com
# GITLAB_TOKEN=your-gitlab-token
# GITLAB_WEBHOOK_SECRET=your-webhook-secret

# LDAP (for SSO LDAP authentication — requires: pip install ldap3)
# LDAP configuration is managed through the SSO API, not environment variables.

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                     DOCKER COMPOSE PRODUCTION VARS                       ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# The following variables are used in docker-compose.prod.yml.
# Put these in the project ROOT .env file (not backend/.env):
# POSTGRES_USER=agentvalue
# POSTGRES_PASSWORD=your-strong-password
# POSTGRES_DB=agentvalue
# MINIO_ROOT_USER=your-minio-user
# MINIO_ROOT_PASSWORD=your-minio-password
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=your-grafana-password

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║              V2.1+ LATER FEATURES (API-Managed, No Env Vars)            ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# The following features are configured through their respective APIs — no
# environment variables are needed:
#
#   SSO / OIDC ................ /api/v1/admin/sso/configs
#   Sensitive Words ........... /api/v1/admin/sensitive-words
#   Model Fallback ............ /api/v1/admin/model-fallback
#   NL2SQL .................... /api/v1/admin/nl2sql
#   Document Parsing .......... pip install pdfplumber, python-docx, etc.
#     (uses ATTACHMENT_DIR for file storage)
#   Session Analytics ......... Auto-collected, no config needed
#   API Health Monitoring ..... Auto-collected, no config needed
